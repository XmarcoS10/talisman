{
  "name": "talisman",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Gioco manageriale di calcio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node src/sim-cli/sim.ts",
    "bench": "node tools/bench.ts",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "assets": "node tools/assets/cli.ts"
  },
  "build": {
    "appId": "it.talisman.game",
    "productName": "Tactic F.C. Manager",
    "copyright": "Marco, con licenza GPL-3.0",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TFM27-Setup.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "license": "GPL-3.0-only",
  "author": "Marco",
  "dependencies": {
    "facesjs": "5.0.3"
  }
}
